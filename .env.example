# Public base URL used for canonical URLs, Open Graph, robots.txt and the
# sitemap. Must match the exact address you add to Google Search Console
# (including www / non-www), with no trailing slash.
NEXT_PUBLIC_SITE_URL=https://squarebirdnet.com

# Where the lead form is delivered, via formsubmit.co. Defaults to the contact
# email in data/site.ts. After activating the form, FormSubmit shows a random
# alias for the inbox — put it here to keep the real address out of the page.
NEXT_PUBLIC_FORMSUBMIT_ID=

# Optional: Google Search Console "HTML tag" verification token (the content
# value only). Not needed if you verify the domain through DNS.
NEXT_PUBLIC_GSC_VERIFICATION=
