# Public base URL used for canonical URLs, Open Graph and the sitemap.
NEXT_PUBLIC_SITE_URL=https://www.squarebirdnet.com

# Endpoint the lead form posts to. Leave unset in development — the form then
# resolves locally so the submitting/success/error states can be demonstrated.
# Point this at your own server route; never put provider credentials in a
# NEXT_PUBLIC_ variable, they belong on the server only.
NEXT_PUBLIC_LEAD_ENDPOINT=
